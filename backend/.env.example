SECRET_KEY=change-me-to-a-very-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Database ────────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://<user>:<password>@cluster0.iq2to1q.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=battle_room

# ─── AI Provider ─────────────────────────────────────────────────
# Set to "mock" to use the built-in mock provider (no API key needed)
# Set to "openai" to use real OpenAI generation
AI_PROVIDER=mock

# Only required when AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ─── CORS ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
